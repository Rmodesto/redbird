# Copy to .env.local and fill in. Never commit real secrets.

# ── Google AdSense ───────────────────────────────────────────────
# Your AdSense publisher id, format ca-pub-XXXXXXXXXXXXXXXX.
# Leave EMPTY to ship with no ads: all ad slots render nothing (no box,
# no "Advertisements" label, no reserved space) and the AdSense script
# and site-verification meta tag are not emitted. Set it only once your
# site is approved and you have a publisher id.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Site ─────────────────────────────────────────────────────────
# Canonical origin used for metadata, canonicals, sitemap and robots.
# Must be the production www origin in prod.
NEXT_PUBLIC_SITE_URL=https://www.subwaysounds.net

# ── Database (Prisma / Neon Postgres) ────────────────────────────
# Server-only. The build must not require this — pages degrade gracefully
# when it is unset. Set it in the deploy environment, not here.
DATABASE_URL=

# ── YouTube sync (admin only) ────────────────────────────────────
# Needed by POST /api/videos/sync to populate the Video / VideoStation
# tables from the channel. Server-only.
YOUTUBE_API_KEY=
