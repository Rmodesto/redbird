datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  clerkUserId   String   @unique
  email         String   @unique
  firstName     String?
  lastName      String?
  imageUrl      String?
  role          String   @default("AUTHOR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         Post[]

  @@index([clerkUserId])
}

model Post {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  excerpt            String    @default("")
  content            String
  contentBlocks      String?
  featuredImage      String?
  featuredImageAlt   String?
  status             String    @default("DRAFT")
  publishedAt        DateTime?
  authorId           String
  author             User      @relation(fields: [authorId], references: [id])
  authorName         String
  readingTimeMinutes Int       @default(0)
  metaTitle          String?
  metaDescription    String?
  ogImage            String?
  canonicalUrl       String?
  keywords           String    @default("[]")
  category           String    @default("")
  tags               String    @default("[]")
  views              Int       @default(0)
  featured           Boolean   @default(false)
  authorImage        String?
  authorRole         String    @default("Contributing Writer")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  videos             VideoPost[]

  @@index([status, publishedAt])
  @@index([authorId])
}

model Video {
  id            String         @id @default(cuid())
  youtubeId     String         @unique
  title         String
  description   String         @default("")
  thumbnailUrl  String         @default("")
  channelId     String         @default("")
  channelTitle  String         @default("")
  publishedAt   DateTime?
  duration      String?
  tags          String         @default("[]")
  status        String         @default("ACTIVE")
  // Tagging review state (admin video tagger). reviewed = a human has either
  // confirmed station tags or explicitly skipped this video, so it leaves the
  // "needs review" queue. SKIP = reviewed with no station tags.
  reviewed      Boolean        @default(false)
  reviewedAt    DateTime?
  reviewNote    String?
  syncedAt      DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  stations      VideoStation[]
  posts         VideoPost[]

  @@index([status])
  @@index([channelId])
  @@index([publishedAt])
  @@index([reviewed])
}

model VideoStation {
  id          String   @id @default(cuid())
  videoId     String
  stationSlug String
  matchType   String   @default("AUTO")
  confidence  Float    @default(1.0)
  createdAt   DateTime @default(now())
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, stationSlug])
  @@index([stationSlug])
  @@index([videoId])
}

// Manual pin of a video onto a specific blog post (the tagger's "pin to a post").
// Posts that merely reference a tagged station are derived, not stored here.
model VideoPost {
  id        String   @id @default(cuid())
  videoId   String
  postId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([videoId, postId])
  @@index([postId])
  @@index([videoId])
}
